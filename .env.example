# ---- Скопируй этот файл в .env и заполни своими значениями ----
# Команда: cp .env.example .env

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=your_telegram_bot_token_here

# Твой Telegram user_id (число). Узнать можно у бота @userinfobot.
# Пока бот работает только для тебя. Поставь 0, чтобы отвечать всем (для теста).
OWNER_USER_ID=0

# (необязательно) Ключ DeepL для перевода. Если пусто — используется
# бесплатный Google Translate через deep-translator, ключ не нужен.
DEEPL_API_KEY=

# Как часто (в минутах) бот проверяет базу и шлёт слова на повторение.
CHECK_INTERVAL_MINUTES=5

# Имя файла базы данных SQLite (можно оставить как есть).
DB_PATH=words.db
